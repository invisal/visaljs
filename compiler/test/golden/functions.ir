function f(%callee0, %n0)
bb0:
  %0 = const 1
  %1 = le %n0, %0  !mayThrow
  branch %1, bb1, bb2
bb1:
  %2 = const 1
  jump bb3
bb2:
  %3 = const undefined
  %4 = const 1
  %5 = sub %n0, %4  !mayThrow
  %6 = call %callee0, %3, %5  !mayThrow
  %7 = mul %n0, %6  !mayThrow
  jump bb3
bb3:  ; preds bb1, bb2
  %8 = phi [bb1: %2], [bb2: %7]
  return %8
