function main()
bb0:
  %Point0 = make_function Point
  declare_global function ."Point", %Point0  !mayThrow
  declare_global var ."fact"  !mayThrow
  %0 = global_this
  %Point1 = get_prop %0, ."Point"  !mayThrow
  %1 = get_prop %Point1, ."prototype"  !mayThrow
  %2 = make_function anonymous
