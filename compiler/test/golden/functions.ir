  %3 = make_function f
  %4 = global_this
  set_prop %4, %3, ."fact"  !mayThrow
  %5 = global_this
  %Point2 = get_prop %5, ."Point"  !mayThrow
  %6 = global_this
  %fact0 = get_prop %6, ."fact"  !mayThrow
  %7 = const undefined
  %8 = const 3
  %9 = call %fact0, %7, %8  !mayThrow
  %10 = construct_direct Point(%Point2, %9)  !mayThrow
  %11 = get_prop %10, ."get"  !mayThrow
  %12 = call %11, %10  !mayThrow
  %13 = call_runtime print(%12)  !mayThrow
  %14 = const undefined
  return %14

function Point(%this0, %x0)
bb0:
  %this1 = sloppy_this %this0
  set_prop %this1, %x0, ."x"  !mayThrow
  %0 = const undefined
  return %0

function anonymous(%this0)
bb0:
  %this1 = sloppy_this %this0
  %0 = get_prop %this1, ."x"  !mayThrow
