globals @0 total

function main()
bb0:
  %0 = empty
  store_global @0, %0
  %fib0 = make_function fib
  declare_global function ."fib", %fib0  !mayThrow
  %1 = const 0
  store_global @0, %1
  %i0 = empty
  %i1 = const 0
  jump bb2
bb1:
  %total0 = load_global @0
  %2 = call_runtime print(%total0)  !mayThrow
  %3 = const undefined
  return %3
bb2:  ; preds bb0, bb4
  %i2 = phi [bb0: %i1], [bb4: %i3]
  %4 = const 10
  %5 = lt %i2, %4  !mayThrow
  branch %5, bb3, bb1
bb3:
  %6 = const 2
  %7 = mod %i2, %6  !mayThrow
  %8 = const 0
  %9 = strict_eq %7, %8
  branch %9, bb5, bb7
bb4:  ; preds bb5, bb7
  %10 = to_numeric %i2  !mayThrow
  %i3 = inc %10  !mayThrow
  jump bb2
bb5:
  jump bb4
bb7:
  %total1 = load_global @0
  %11 = call_direct fib(%i2)  !mayThrow
  %12 = add %total1, %11  !mayThrow
  store_global @0, %12
  jump bb4

function fib(%n0)
bb0:
  %0 = const 2
  %1 = lt %n0, %0  !mayThrow
  branch %1, bb1, bb3
bb1:
  return %n0
bb3:
  %2 = const 1
  %3 = sub %n0, %2  !mayThrow
  %4 = call_direct fib(%3)  !mayThrow
  %5 = const 2
  %6 = sub %n0, %5  !mayThrow
  %7 = call_direct fib(%6)  !mayThrow
  %8 = add %4, %7  !mayThrow
