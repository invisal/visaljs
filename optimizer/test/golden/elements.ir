globals @0 sieve, @1 byKey

function main() strict
bb0:
  %0 = const undefined
  return %0

function sieve(%n0) strict
bb0:
  %0 = global_name "Array"  !mayThrow
  %1 = const 1
  %2: Number = num_add %n0, %1
  %3: Object = new %0, %2  !mayThrow
  %4 = get_prop %3, ."fill"  !mayThrow
  %5 = const false
  %composite0 = call %4, %3, %5  !mayThrow
  %count0 = const 0
  %i0 = const 2
  jump bb2
bb1:
  return %count1
bb2:  ; preds bb0, bb4
  %i1: Number (f64) = phi [bb0: %i0], [bb4: %i2]
  %count1: Number (f64) = phi [bb0: %count0], [bb4: %count2]
  %6: Boolean (bool) = num_le %i1, %n0
  branch %6, bb3, bb1
bb3:
  %7 = get_index %composite0, %i1  !mayThrow
  branch %7, bb5, bb7
bb4:  ; preds bb5, bb8
  %count2: Number (f64) = phi [bb5: %count1], [bb8: %count3]
  %i2: Number (f64) = num_inc %i1
  jump bb2
bb5:
  jump bb4
bb7:
  %count3: Number (f64) = num_inc %count1
  %j0: Number (f64) = num_mul %i1, %i1
  jump bb9
bb8:
  jump bb4
bb9:  ; preds bb7, bb11
  %j1: Number (f64) = phi [bb7: %j0], [bb11: %j2]
  %8: Boolean (bool) = num_le %j1, %n0
  branch %8, bb10, bb8
bb10:
  %9 = const true
  set_index %composite0, %j1, %9  !mayThrow
  jump bb11
bb11:
  %j2: Number (f64) = num_add %j1, %i1
  jump bb9

function byKey(%o0, %k0) strict
bb0:
  %0 = get_index %o0, %k0  !mayThrow
  %1: Int32 = get_prop %o0, ."length"  !mayThrow
  %2: Number|String = add %0, %1  !mayThrow
  return %2
