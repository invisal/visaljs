globals @0 sumTo, @1 hash, @2 label

function main() strict
bb0:
  %0 = const undefined
  return %0

function sumTo(%n0) strict
bb0:
  %s0 = const 0
  %i0 = const 0
  jump bb2
bb1:
  return %s1
bb2:  ; preds bb0, bb4
  %i1: Int32 (i32) = phi [bb0: %i0], [bb4: %i2]
  %s1: Number (f64) = phi [bb0: %s0], [bb4: %s2]
  %0: Boolean (bool) = num_lt %i1, %n0
