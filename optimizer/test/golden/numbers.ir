function label(%x0) strict
bb0:
  %out0 = const ""
  %0 = iter_start %x0  !mayThrow
  jump bb1
bb1:  ; preds bb0, bb5
  %out1: String = phi [bb0: %out0], [bb5: %out2]
  %part0 = iter_next %0  !mayThrow
  %1: Boolean = not_empty %part0
