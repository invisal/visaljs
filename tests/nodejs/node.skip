# Node's tests that can never run compiled by visaljs: `test-file.js  reason`, one a line.
# A test that fails for something visaljs could do still runs (it just isn't in node.results).

# vm runs source text, which a program compiled ahead of time can't
test-buffer-alloc.js                     vm.runInNewContext (a cross-realm ArrayBuffer)
test-buffer-bytelength.js                vm.runInNewContext (a cross-realm ArrayBuffer)
test-buffer-from.js                      vm.runInNewContext (cross-realm objects)
test-crypto-subtle-cross-realm.js        vm.runInNewContext (another realm's crypto.subtle)

# no threads: SharedArrayBuffer and transferring between workers
test-buffer-sharedarraybuffer.js         SharedArrayBuffer (no threads)
test-buffer-pool-untransferable.js       Buffer's shared pool and MessageChannel transfer lists

# Node's built-in modules are loaded ahead of time: patching one before require() changes nothing
test-zlib-kmaxlength-rangeerror.js       patches buffer.kMaxLength before require('zlib')
test-zlib-brotli-kmaxlength-rangeerror.js  patches buffer.kMaxLength before require('zlib')
test-zlib-zstd-kmaxlength-rangeerror.js  patches buffer.kMaxLength before require('zlib')

# domain (deprecated, DEP0032): its binding to timers and errors isn't provided
test-crypto-domain.js                    domain
test-crypto-domains.js                   domain
test-http-client-response-domain.js      domain
test-timers-immediate-queue-throw.js     domain
test-timers-reset-process-domain-on-throw.js  domain

# no eval: Function() and vm compile source text
test-stream-ispaused.js                  Function() constructor
test-net-binary.js                       eval()
# not provided: http2
test-stream-pipeline-http2.js            http2
# async_hooks' resource events (init/before/after) aren't emitted
test-stream-writable-samecb-singletick.js  async_hooks.createHook TickObject
# setImmediate gives an Immediate (not its id) when the program uses one as an object (.unref(),
# Symbol.dispose…): this checks its constructor's name, which the rules don't look for
test-timers-clearImmediate-als.js        Immediate's constructor.name

# a test that expects the working directory to be Node's checkout (./test/fixtures/…)
test-fs-cp-async-file-url.mjs            a path relative to Node's checkout (./test/fixtures/copy)

# Node's internal handle list
test-fs-watch-recursive-assert-leaks.js  process._getActiveHandles (Node's internal handle list)
test-process-getactivehandles.js         process._getActiveHandles
test-process-getactiverequests.js        process._getActiveRequests

# Node's libuv handle objects (socket._handle), which a compiled program's sockets don't have
test-http-client-spurious-aborted.js     patches res.socket._handle.close
test-child-process-pipe-dataflow.js      patches stdout._handle.readStart
test-net-connect-keepalive.js            patches client._handle.setKeepAlive
test-net-connect-nodelay.js              patches client._handle.setNoDelay
test-net-keepalive-interval-count.js     patches client._handle.setKeepAlive
test-net-server-keepalive.js             patches server._handle.onconnection
test-net-server-nodelay.js               patches server._handle.onconnection
test-net-socket-setnodelay.js            sockets made over fake handle objects
test-net-socket-write-after-close.js     closes client._handle itself

# the internet: a remote host's name looked up
test-http-client-req-error-dont-double-fire.js  ../common/internet (a remote host)
test-net-better-error-messages-port-hostname.js  ../common/internet (an unresolvable name looked up)
test-net-connect-immediate-finish.js     ../common/internet (an unresolvable name looked up)

# Node's HTTPParser on the socket (socket.parser): ours parses in C, without one
test-http-server-keepalive-end.js        req.socket.parser.incoming
test-http-server-connection-list-when-close.js  req.socket.parser.free
test-http-parser.js                      _http_common's HTTPParser
test-http-parser-max-header-pairs-cache.js  _http_common's HTTPParser
test-http-parser-memory-retention.js     _http_common's HTTPParser
test-http-header-value-relaxed.js        _http_common's HTTPParser
test-http-set-max-idle-http-parser.js    _http_common's parsers (HTTPParser's free list)
test-http-dump-req-when-res-ends.js      the socket's 'data' listener (Node's parser reads through one)

# another Node process: a compiled program has no Node to fork (child_process.fork, cluster)
test-http-server-stale-close.js          child_process.fork
test-http-server-drop-connections-in-cluster.js  cluster.fork
test-http-max-header-size.js             node --max-http-header-size (Node's command line)
test-net-listen-exclusive-random-ports.js  cluster.fork
test-net-listen-handle-in-cluster-1.js   cluster.fork
test-net-listen-twice.js                 cluster.fork
test-net-server-close-before-ipc-response.js  cluster.fork
test-net-socket-constructor.js           cluster.fork (a worker given descriptors 4–6)
test-net-child-process-connect-reset.js  child_process.spawn of node with an 'ipc' channel

# no threads: a socket or server moved to a worker (worker_threads, MessageChannel)
test-crypto-key-objects-messageport.js   MessageChannel
test-crypto-keyobject-clone-transfer.js  MessageChannel transfer lists
test-crypto-worker-thread.js             worker_threads.Worker
test-net-server-transfer-worker.js       worker_threads.Worker
test-net-socket-transfer-worker-http.js  worker_threads.Worker
test-net-socket-transfer-worker.js       worker_threads.Worker
test-net-transfer-guards.js              MessageChannel transfer lists
test-process-exec-argv.js                worker_threads.Worker
test-process-execve-worker-threads.js    worker_threads.Worker
test-process-threadCpuUsage-worker-threads.js  worker_threads.Worker
test-webcrypto-cryptokey-clone-transfer.js  MessageChannel transfer lists
test-webcrypto-cryptokey-workers.js      worker_threads.Worker

# process.report (Node's diagnostic report)
test-http-agent-reuse-drained-socket-only.js  process.report.getReport()

# child_process.fork() and IPC: forking starts a Node on a module, which a compiled program doesn't have
test-child-process-disconnect.js         child_process.fork
test-child-process-fork-abort-signal.js  child_process.fork
test-child-process-fork-advanced-header-serialization.js  child_process.fork
test-child-process-fork-and-spawn.js     child_process.fork
test-child-process-fork-args.js          child_process.fork
test-child-process-fork-close.js         child_process.fork
test-child-process-fork-closed-channel-segfault.js  child_process.fork
test-child-process-fork-detached.js      child_process.fork
test-child-process-fork-dgram.js         child_process.fork
test-child-process-fork-exec-argv.js     child_process.fork
test-child-process-fork-getconnections.js  child_process.fork
test-child-process-fork-net-server.js    child_process.fork
test-child-process-fork-net-socket.js    child_process.fork
test-child-process-fork-net.js           child_process.fork
test-child-process-fork-no-shell.js      child_process.fork
test-child-process-fork-ref.js           child_process.fork
test-child-process-fork-ref2.js          child_process.fork
test-child-process-fork-stdio-string-variant.js  child_process.fork
test-child-process-fork-stdio.js         child_process.fork
test-child-process-fork-timeout-kill-signal.js  child_process.fork
test-child-process-fork-url.mjs          child_process.fork
test-child-process-fork3.js              child_process.fork
test-child-process-internal.js           child_process.fork
test-child-process-ipc-next-tick.js      child_process.fork
test-child-process-net-reuseport.js      child_process.fork
test-child-process-prototype-tampering.mjs  child_process.fork
test-child-process-send-after-close.js   child_process.fork
test-child-process-send-cb.js            child_process.fork
test-child-process-send-keep-open.js     child_process.fork
test-child-process-send-returns-boolean.js  child_process.fork
test-child-process-send-type-error.js    child_process.fork
test-child-process-send-utf8.js          child_process.fork
test-child-process-server-close.js       child_process.fork
test-child-process-silent.js             child_process.fork
test-child-process-spawn-typeerror.js    child_process.fork
test-process-external-stdio-close.js     child_process.fork
test-process-redirect-warnings.js        child_process.fork

# the 'ipc' stdio and child.send(): no IPC channel between processes (it comes with fork)
test-child-process-advanced-serialization-largebuffer.js  stdio 'ipc'
test-child-process-advanced-serialization-splitted-length-field.js  stdio 'ipc'
test-child-process-advanced-serialization.js  stdio 'ipc'
test-child-process-constructor.js        stdio 'ipc'
test-child-process-stdin-ipc.js          stdio 'ipc'
test-child-process-stdout-ipc.js         stdio 'ipc'
test-process-external-stdio-close-spawn.js  stdio 'ipc'

