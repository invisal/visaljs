test-child-process-can-write-to-stdout.js  process.execPath as Node
test-child-process-detached.js           process.execPath as Node
test-child-process-exec-maxbuf.js        process.execPath as Node
test-child-process-execfile-maxbuf.js    process.execPath as Node
