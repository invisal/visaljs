---
// One page per chapter of the guide (src/guide/*.mdx).
import { render } from "astro:content";
import CodeBlock from "../../components/CodeBlock.astro";
import FloatTable from "../../components/FloatTable.astro";
import GuideContents from "../../components/GuideContents.astro";
import Heading from "../../components/Heading.astro";
import InlineCode from "../../components/InlineCode.astro";
import Note from "../../components/Note.tsx";
import Pair from "../../components/Pair.astro";
import SubHeading from "../../components/SubHeading.astro";
import Prose from "../../components/Prose.astro";
import Layout from "../../layouts/Layout.astro";
import { chapters } from "../../lib/guide.ts";

export async function getStaticPaths() {
  return (await chapters()).map((chapter, n, all) => ({ params: { chapter: chapter.id }, props: { chapter, prev: all[n - 1], next: all[n + 1] } }));
}

const REPO = "https://github.com/invisal/visaljs/blob/main/";

const { chapter, prev, next } = Astro.props;
const { title, good, bad, files } = chapter.data;
const { Content } = await render(chapter);
/** What the guide's MDX may use without importing it. */
const components = { CodeBlock, Pair, Note, FloatTable, h2: Heading, h3: SubHeading, code: InlineCode };
const refs = files.map((f) => [f, f] as const);
const tradeoffs = [
  ["Good", good, "border-kumo-success/40 text-kumo-success"],
  ["Bad", bad, "border-kumo-danger/40 text-kumo-danger"],
] as const;
---

<Layout title={`${title} · JavaScript to C · visaljs`} page="guide" flush>
  <GuideContents slot="sidebar" current={chapter.id} />
  <article class="space-y-10">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <div class="guide">
      <Content components={components} />
    </div>
    <section id="tradeoffs" class="scroll-mt-16 space-y-4">
      {
        (good.length > 0 || bad.length > 0) && (
          <>
            <h2 class="text-xl font-semibold tracking-tight">Good and bad</h2>
            <div class="grid max-w-5xl gap-3 md:grid-cols-2">
              {tradeoffs.map(([title, items, tone]) => (
                <div class:list={["rounded-lg border p-4", tone]}>
                  <h3 class="mb-2 text-sm font-semibold tracking-wide uppercase">{title}</h3>
                  <ul class="list-disc space-y-1.5 pl-4 text-sm text-kumo-default">
                    {items.map((t) => (
                      <li>
                        <Prose text={t} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </>
        )
      }
      {
        refs.length > 0 && (
          <p class="text-sm text-kumo-subtle">
            Read more:{" "}
            {refs.map(([path, title], i) => (
              <>
                {i > 0 && " · "}
                <a href={REPO + path} class="text-kumo-subtle underline decoration-kumo-line hover:text-kumo-default">
                  {title}
                </a>
              </>
            ))}
          </p>
        )
      }
    </section>
    <nav class="flex justify-between gap-4 border-t border-kumo-hairline pt-6 text-sm">
      {
        prev ? (
          <a href={`/guide/${prev.id}/`} class="text-kumo-subtle hover:text-kumo-strong">
            ← {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/guide/${next.id}/`} class="text-right text-kumo-subtle hover:text-kumo-strong">
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>
</Layout>
