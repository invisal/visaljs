{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "visaljs",
  "compatibility_date": "2026-09-30",
  // Pull requests' builds deploy a Preview (`wrangler preview`), which needs this block, even empty.
  "previews": {},
  // Static assets only: Astro builds every page to HTML at build time.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
