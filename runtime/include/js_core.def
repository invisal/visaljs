JS_CORE_FN(GLOBAL, "encodeURI", global_encode_uri, 1)
JS_CORE_FN(GLOBAL, "encodeURIComponent", global_encode_uri_component, 1)

/* console, in Node's order: own enumerable methods, each its own function
 * (console.info !== console.log), though several share a native */
JS_CORE_HOST_FN(CONSOLE, "log", console_log, 0)
JS_CORE_HOST_FN(CONSOLE, "warn", console_error, 0)
