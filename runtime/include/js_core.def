JS_CORE_FN(OBJECT, "freeze", object_freeze, 1)
JS_CORE_FN(OBJECT, "getPrototypeOf", object_get_prototype_of, 1)
JS_CORE_FN(OBJECT, "setPrototypeOf", object_set_prototype_of, 2)
JS_CORE_FN(OBJECT, "isExtensible", object_is_extensible, 1)
JS_CORE_FN(OBJECT, "isFrozen", object_is_frozen, 1)
JS_CORE_FN(OBJECT, "isSealed", object_is_sealed, 1)
JS_CORE_FN(OBJECT, "keys", object_keys, 1)
JS_CORE_FN(OBJECT, "entries", object_entries, 1)
JS_CORE_FN(OBJECT, "fromEntries", object_from_entries, 1)
JS_CORE_FN(OBJECT, "values", object_values, 1)
JS_CORE_FN(OBJECT, "groupBy", object_group_by, 2)
JS_CORE_FN(OBJECT_PROTO, "__defineGetter__", object_proto_define_getter, 2)
JS_CORE_FN(OBJECT_PROTO, "__defineSetter__", object_proto_define_setter, 2)
JS_CORE_FN(OBJECT_PROTO, "hasOwnProperty", object_proto_has_own_property, 1)
JS_CORE_FN(OBJECT_PROTO, "__lookupGetter__", object_proto_lookup_getter, 1)
JS_CORE_FN(OBJECT_PROTO, "__lookupSetter__", object_proto_lookup_setter, 1)
JS_CORE_FN(OBJECT_PROTO, "isPrototypeOf", object_proto_is_prototype_of, 1)
JS_CORE_FN(OBJECT_PROTO, "propertyIsEnumerable", object_proto_property_is_enumerable, 1)
JS_CORE_FN(OBJECT_PROTO, "toString", object_proto_to_string, 0)
JS_CORE_FN(OBJECT_PROTO, "valueOf", object_proto_value_of, 0)
JS_CORE_ACCESSOR(OBJECT_PROTO, "__proto__", object_proto_get_proto, object_proto_set_proto)
JS_CORE_FN(OBJECT_PROTO, "toLocaleString", object_proto_to_locale_string, 0)

