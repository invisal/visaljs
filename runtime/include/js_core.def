/*
 * js_core.def — the core built-in methods a program installs only when it names them,
 * in V8's order. One line per property:
 *
 *   JS_CORE_FN(target, "name", native, length)        a method
 *   JS_CORE_HOST_FN(target, "name", native, length)   a host method (enumerable: console.log)
 *   JS_CORE_ACCESSOR(target, "name", getter, setter)   an accessor
 *   JS_CORE_NUMBER(target, "name", value)              a constant (read-only, fixed)
 *   JS_CORE_ALIAS(target, "name", "earlier")           the same function as an earlier entry
 *   JS_CORE_ALIAS_OF(target, "name", from, "earlier")  the same, from an earlier entry on `from`
 *   JS_CORE_SYMBOL_GETTER(target, symbol, getter)      a well-known-symbol getter (always installed)
 *   JS_CORE_SYMBOL_ALIAS(target, symbol, "earlier")    a well-known-symbol alias (always installed)
 *
 * Included by js_builtins.h (to declare the natives), by runtime/src/core_all.c (every entry,
 * for the test hosts) and parsed by the compiler (compiler/src/emit/core.ts), which emits the
 * entries a program names into its C file. No #include guard: it is read several times.
 */

/* Object (§20.1) */
JS_CORE_FN(OBJECT, "assign", object_assign, 2)
JS_CORE_FN(OBJECT, "getOwnPropertyDescriptor", object_get_own_property_descriptor, 2)
JS_CORE_FN(OBJECT, "getOwnPropertyDescriptors", object_get_own_property_descriptors, 1)
