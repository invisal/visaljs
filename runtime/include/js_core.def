JS_CORE_ALIAS_OF(GLOBAL, "parseInt", NUMBER, "parseInt")
JS_CORE_FN(GLOBAL, "eval", global_eval, 1)
JS_CORE_FN(GLOBAL, "isNaN", global_is_nan, 1)
JS_CORE_FN(GLOBAL, "isFinite", global_is_finite, 1)

/* The URI handling functions (§19.2.6) */
JS_CORE_FN(GLOBAL, "decodeURI", global_decode_uri, 1)
